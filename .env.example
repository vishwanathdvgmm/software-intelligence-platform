# Example environment configuration for SIP
# Copy to .env and fill in actual values — DO NOT commit .env

# ─── Application ───────────────────────────────────────────────────────────
SIP_ENV=development
SIP_LOG_LEVEL=INFO
SIP_LOG_FORMAT=console   # "console" (dev) or "json" (prod)

# ─── PostgreSQL ────────────────────────────────────────────────────────────
SIP_POSTGRES_HOST=localhost
SIP_POSTGRES_PORT=5432
SIP_POSTGRES_DB=sip
SIP_POSTGRES_USER=sip
SIP_POSTGRES_PASSWORD=changeme

# ─── Qdrant ────────────────────────────────────────────────────────────────
SIP_QDRANT_HOST=localhost
SIP_QDRANT_PORT=6333
SIP_QDRANT_API_KEY=

# ─── Redis ─────────────────────────────────────────────────────────────────
SIP_REDIS_URL=redis://localhost:6379/0

# ─── Embedding model (configurable default, not a lock-in) ─────────────────
SIP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIP_EMBEDDING_DIMENSION=384
SIP_EMBEDDING_PROVIDER=sentence_transformers   # "sentence_transformers" | "openai"

# ─── Reranker model (configurable default) ─────────────────────────────────
SIP_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SIP_RERANKER_PROVIDER=sentence_transformers    # "sentence_transformers" | "cohere"

# ─── LLM (configurable default) ────────────────────────────────────────────
SIP_LLM_PROVIDER=ollama                        # "ollama" | "openai" | "gemini" | "anthropic"
SIP_LLM_MODEL=qwen2.5:7b
SIP_LLM_BASE_URL=http://localhost:11434        # Required for Ollama
SIP_OPENAI_API_KEY=
SIP_GEMINI_API_KEY=
SIP_ANTHROPIC_API_KEY=
